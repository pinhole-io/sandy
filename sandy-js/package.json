{
  "name": "sandy-js",
  "version": "0.1.0",
  "description": "Node.js and Bun bindings for Sandy shell sandboxing",
  "license": "BSD-4-Clause",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md"
  ],
  "napi": {
    "binaryName": "sandy-js",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "npm run build:native && npm run build:types",
    "build:native": "napi build --platform --release",
    "build:native:debug": "napi build --platform",
    "build:types": "tsc --noEmit",
    "test": "npm run build:native:debug && node test/run.mjs",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "typescript": "7.0.2"
  }
}
